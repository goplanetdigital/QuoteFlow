# QuoteFlow test deployment only. Never use live credentials here.
SITE_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Service fee, not the value of the customer's quotation. Minor currency units.
QUOTE_EXPORT_AMOUNT=2900
QUOTE_EXPORT_CURRENCY=usd
# Dedicated QuoteFlow PostgreSQL with verified TLS in hosted environments.
DATABASE_URL=
# Owner must confirm this address and approve policy copy before publication.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Hosted database URL must identify this dedicated database; scope is Preview only.
QF_DATABASE_SCOPE=preview
QF_DATABASE_NAME=
# At least 32 random characters. Server-only HMAC key, never a public variable.
UPLOAD_ABUSE_SECRET=
